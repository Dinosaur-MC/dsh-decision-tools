{
  "name": "dsh-decision-tools",
  "version": "0.4.0",
  "description": "DSH agent tools for local Ollama System One decision models: classify, answer yes/no, and score against a rubric in one batched request.",
  "keywords": [
    "dsh-plugin",
    "ollama",
    "decision",
    "system-one",
    "classification",
    "reranking"
  ],
  "license": "MIT",
  "author": "Dinosaur_MC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dinosaur-MC/dsh-decision-tools.git"
  },
  "homepage": "https://github.com/Dinosaur-MC/dsh-decision-tools#readme",
  "bugs": {
    "url": "https://github.com/Dinosaur-MC/dsh-decision-tools/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./decision": "./lib/decision-entry.js",
    "./monitor": "./lib/monitor-entry.js",
    "./skill": "./lib/skill.js",
    "./client": "./lib/browser.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "assets/**",
    "docs/*.md",
    "scripts/*.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "link-peers": "node scripts/link-peers.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2",
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
